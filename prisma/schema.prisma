generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// MODULE 1 : UTILISATEURS & PROFILS
// =========================================================================

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique @db.VarChar(180)
  phoneNumber     String?    @unique @map("phone_number") @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  // Horodatage du dernier changement de mot de passe — permet d'invalider
  // les sessions JWT déjà émises (ex. appareil volé) dès qu'un mot de passe
  // est réinitialisé, sans avoir à gérer de liste de révocation.
  passwordChangedAt DateTime? @map("password_changed_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  status          UserStatus @default(active)
  role            UserRole   @default(patient)
  // Permissions accordées à un compte "modérateur" (ignoré pour les autres
  // rôles) — tableau de clés Permission (lib/permissions.ts), ex.
  // ["manage_finances"]. NULL = aucune permission accordée. Remplace le jeu
  // de capacités fixe des modérateurs par un ensemble configurable par
  // compte (voir prisma/backfill-moderator-permissions.ts pour les comptes
  // modérateurs créés avant cette colonne).
  permissions     Json?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  patientProfile      PatientProfile?
  therapistProfile    TherapistProfile?
  patientSubscription PatientSubscription?

  patientAssignments   PatientTherapistAssignment[] @relation("PatientAssignments")
  therapistAssignments PatientTherapistAssignment[] @relation("TherapistAssignments")

  patientAppointments   Appointment[] @relation("PatientAppointments")
  therapistAppointments Appointment[] @relation("TherapistAppointments")

  verificationTokens VerificationToken[]
  otpCodes           OtpCode[]
  sentMessages       Message[]
  payments           Payment[]
  therapistEarnings  TherapistEarning[]
  auditLogs          AuditLog[]
  submittedArticles  SubmittedArticle[] @relation("ArticleAuthor")
  reviewedArticles   SubmittedArticle[] @relation("ArticleReviewer")

  @@index([status, role])
  @@map("users")
}

/// Liens à usage unique envoyés par email : vérification d'adresse et réinitialisation de mot de passe.
model VerificationToken {
  id        Int                   @id @default(autoincrement())
  userId    Int                   @map("user_id")
  tokenHash String                @unique @map("token_hash") @db.VarChar(255)
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  email_verify
  password_reset
}

/// Code à 6 chiffres pour la vérification du numéro de téléphone, par SMS ou WhatsApp.
model OtpCode {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  codeHash    String     @map("code_hash") @db.VarChar(255)
  channel     OtpChannel
  phoneNumber String     @map("phone_number") @db.VarChar(20)
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("otp_codes")
}

enum OtpChannel {
  sms
  whatsapp
}

enum UserStatus {
  active
  suspended
  archived
}

enum UserRole {
  patient
  therapist
  admin
  // Accès admin restreint : peut consulter utilisateurs/thérapeutes et agir
  // sur les finances (valider paiements, marquer des reversements), mais ne
  // peut ni modifier/suspendre un utilisateur ni valider une candidature.
  moderator
}

model PatientProfile {
  id                Int     @id @default(autoincrement())
  userId            Int     @unique @map("user_id")
  nickname          String  @db.VarChar(50)
  avatarUrl         String? @map("avatar_url") @db.VarChar(255)
  onboardingAnswers Json?   @map("onboarding_answers")
  timezone          String  @default("UTC") @db.VarChar(50)
  // Nombre de séances payées et non encore consommées. Incrémenté quand un
  // paiement passe à "completed", décrémenté à chaque réservation confirmée
  // (et recrédité si le patient annule un rendez-vous en attente).
  sessionCredits    Int     @default(0) @map("session_credits")
  // Horodatage du consentement au traitement des données de santé, donné à
  // l'inscription (les 5 cases du document "Consentement au traitement des
  // données relatives à la santé" étant toutes requises avant validation).
  healthDataConsentAt DateTime? @map("health_data_consent_at")

  user User @relation(fields: [userId], references: [id])

  @@map("patient_profiles")
}

model TherapistProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  specialties       String?   @db.Text
  bio               String?   @db.Text
  profilePictureUrl String?   @map("profile_picture_url") @db.VarChar(255)
  isVerified        Boolean   @default(false) @map("is_verified")
  languages         String?   @db.VarChar(255)
  diplomaUrl        String?   @map("diploma_url") @db.VarChar(512)
  documentsJson     Json?     @map("documents_json")
  rejectedAt        DateTime? @map("rejected_at")
  // Commission K-Kouma sur les séances de ce thérapeute (pourcentage, ex.
  // 20.00 = 20%). NULL = utilise PlatformSettings.defaultCommissionPercent.
  commissionPercent         Decimal?  @map("commission_percent") @db.Decimal(5, 2)
  // Dernier pourcentage explicitement accepté par le thérapeute (couverture
  // juridique) — comparé au pourcentage effectif à chaque connexion ; un
  // écart déclenche une nouvelle demande d'acceptation.
  commissionAcceptedPercent Decimal?  @map("commission_accepted_percent") @db.Decimal(5, 2)
  commissionAcceptedAt      DateTime? @map("commission_accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("therapist_profiles")
}

/// Réglages globaux de la plateforme — ligne unique (id=1).
model PlatformSettings {
  id                       Int      @id @default(1)
  defaultCommissionPercent Decimal  @default(20.00) @map("default_commission_percent") @db.Decimal(5, 2)
  updatedAt                DateTime @updatedAt @map("updated_at")
  updatedById              Int?     @map("updated_by_id")

  @@map("platform_settings")
}

// =========================================================================
// MODULE 2 : ABONNEMENTS & PAIEMENT MOBILE MONEY
// =========================================================================

model SubscriptionPlan {
  id                   Int     @id @default(autoincrement())
  name                 String  @db.VarChar(50)
  price                Decimal @db.Decimal(10, 2)
  currency             String  @default("XOF") @db.VarChar(3)
  videoMinutesIncluded Int     @default(180) @map("video_minutes_included")
  isActive             Boolean @default(true) @map("is_active")

  subscriptions PatientSubscription[]

  @@map("subscription_plans")
}

model PatientSubscription {
  id                    Int                @id @default(autoincrement())
  patientId             Int                @unique @map("patient_id")
  planId                Int                @map("plan_id")
  status                SubscriptionStatus @default(unpaid)
  lastOmTransactionRef  String?            @map("last_om_transaction_ref") @db.VarChar(255)
  currentPeriodStart    DateTime           @map("current_period_start")
  currentPeriodEnd      DateTime           @map("current_period_end")
  videoMinutesRemaining Int                @map("video_minutes_remaining")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  patient User             @relation(fields: [patientId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("patient_subscriptions")
}

enum SubscriptionStatus {
  active
  past_due
  unpaid
}

/// Achat d'un crédit de séance(s) — modèle au paiement à la séance (et non
/// abonnement mensuel). Une fois `completed`, `sessionsCount` est ajouté à
/// `PatientProfile.sessionCredits`.
model Payment {
  id            Int           @id @default(autoincrement())
  patientId     Int           @map("patient_id")
  therapyType   String        @map("therapy_type") @db.VarChar(20) // individuelle | couple | enfant
  sessionsCount Int           @map("sessions_count") // 1 (séance seule) ou 4 (pack)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("XOF") @db.VarChar(3)
  provider      String        @default("paydunya") @db.VarChar(30)
  providerRef   String?       @unique @map("provider_ref") @db.VarChar(255)
  // Numéro depuis lequel le patient dit avoir envoyé l'argent — utilisé
  // uniquement pour les paiements déclarés manuellement (Orange Money),
  // pour aider l'admin à recouper avec l'historique du compte marchand.
  payerPhone    String?       @map("payer_phone") @db.VarChar(20)
  status        PaymentStatus @default(pending)
  // Nombre de séances de ce paiement pas encore réclamées par une réservation
  // — permet de calculer le gain du thérapeute au prorata du prix réel payé
  // (ex: pack de 3 à 28 000 → 9 333/séance), et non du tarif catalogue.
  sessionsRemaining Int        @default(0) @map("sessions_remaining")
  createdAt     DateTime      @default(now()) @map("created_at")
  paidAt        DateTime?     @map("paid_at")

  patient            User          @relation(fields: [patientId], references: [id])
  fundedAppointments Appointment[]

  @@index([patientId, status])
  @@map("payments")
}

enum PaymentStatus {
  pending
  completed
  failed
  canceled
}

/// Gain d'un thérapeute pour une séance effectivement réalisée. Créé quand un
/// rendez-vous passe à "completed" ; le montant est figé au tarif du
/// thérapeute à ce moment-là (indépendant d'un changement ultérieur de tarif).
model TherapistEarning {
  id            Int       @id @default(autoincrement())
  therapistId   Int       @map("therapist_id")
  appointmentId Int       @unique @map("appointment_id")
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("XOF") @db.VarChar(3)
  // Pourcentage de commission K-Kouma appliqué pour calculer `amount` —
  // conservé même si le réglage change ensuite, pour la traçabilité.
  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)
  // Reversement au thérapeute — distinct du paiement du patient, qui lui a
  // déjà eu lieu au moment de l'achat des séances.
  paidOut       Boolean   @default(false) @map("paid_out")
  paidOutAt     DateTime? @map("paid_out_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  therapist   User        @relation(fields: [therapistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([therapistId])
  @@index([therapistId, paidOut])
  @@map("therapist_earnings")
}

// =========================================================================
// MODULE 3 : RELATIONS, MATCHING & RENDEZ-VOUS
// =========================================================================

model PatientTherapistAssignment {
  id          Int              @id @default(autoincrement())
  patientId   Int              @map("patient_id")
  therapistId Int              @map("therapist_id")
  status      AssignmentStatus @default(active)
  assignedAt  DateTime         @default(now()) @map("assigned_at")

  patient   User @relation("PatientAssignments", fields: [patientId], references: [id])
  therapist User @relation("TherapistAssignments", fields: [therapistId], references: [id])

  @@unique([patientId, therapistId])
  @@map("patient_therapist_assignments")
}

enum AssignmentStatus {
  active
  paused
  terminated
}

model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  therapistId     Int               @map("therapist_id")
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(45) @map("duration_minutes")
  status          AppointmentStatus @default(pending)
  type            AppointmentType   @default(video)
  webrtcRoomId    String?           @map("webrtc_room_id") @db.VarChar(100)
  // Paiement qui a fourni le crédit consommé par cette réservation (FIFO) —
  // permet de retrouver le prix réellement payé pour cette séance précise.
  fundedByPaymentId Int?            @map("funded_by_payment_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  patient         User     @relation("PatientAppointments", fields: [patientId], references: [id])
  therapist       User     @relation("TherapistAppointments", fields: [therapistId], references: [id])
  fundedByPayment Payment? @relation(fields: [fundedByPaymentId], references: [id])
  messages        Message[]
  earning         TherapistEarning?

  @@index([scheduledAt])
  @@index([therapistId, scheduledAt])
  @@map("appointments")
}

enum AppointmentStatus {
  pending
  confirmed
  canceled
  completed
}

enum AppointmentType {
  text
  audio
  video
}

/// Message échangé pendant une séance de type "messagerie" (chat).
model Message {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @map("appointment_id")
  senderId      Int       @map("sender_id")
  body          String    @db.Text
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([appointmentId, createdAt])
  @@map("messages")
}

// =========================================================================
// MODULE 4 : WEBRTC SIGNALING
// =========================================================================

model WebrtcSignal {
  id        Int      @id @default(autoincrement())
  roomId    String   @map("room_id") @db.VarChar(100)
  fromRole  String   @map("from_role") @db.VarChar(20)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("webrtc_signals")
}

// =========================================================================
// MODULE 5 : JOURNAL D'AUDIT
// =========================================================================

/// Trace des actions sensibles (admin, authentification...). Volontairement
/// non liée par contrainte stricte à l'auteur : la ligne doit survivre même
/// si le compte de l'auteur est supprimé plus tard (actorEmail en garde une
/// copie lisible indépendamment de la relation).
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorEmail String?  @map("actor_email") @db.VarChar(180)
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   Int?     @map("target_id")
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================================
// MODULE 6 : ARTICLES PROPOSÉS (thérapeutes / modérateurs / admins)
// =========================================================================

/// Article proposé par un thérapeute, un modérateur ou un admin — distinct du
/// contenu éditorial figé de lib/articles.ts (type `Article`), dont le
/// gabarit riche (symptômes, exemple, "à retenir"...) ne convient pas à une
/// contribution libre. Volontairement plus simple : titre, accroche, corps en
/// texte libre. Passe par une file de relecture (`pending`) avant publication
/// — jamais de publication directe, même pour un admin, par cohérence.
model SubmittedArticle {
  id           Int           @id @default(autoincrement())
  authorId     Int           @map("author_id")
  slug         String        @unique @db.VarChar(100)
  title        String        @db.VarChar(200)
  excerpt      String        @db.VarChar(300)
  body         String        @db.Text
  imageUrl     String?       @map("image_url") @db.VarChar(512)
  status       ArticleStatus @default(pending)
  reviewedById Int?          @map("reviewed_by_id")
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  author     User  @relation("ArticleAuthor", fields: [authorId], references: [id])
  reviewedBy User? @relation("ArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([authorId])
  @@map("submitted_articles")
}

enum ArticleStatus {
  pending
  published
  rejected
}
