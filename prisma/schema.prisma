generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// MODULE 1 : UTILISATEURS & PROFILS
// =========================================================================

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique @db.VarChar(180)
  phoneNumber     String?    @unique @map("phone_number") @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  status          UserStatus @default(active)
  role            UserRole   @default(patient)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  patientProfile      PatientProfile?
  therapistProfile    TherapistProfile?
  patientSubscription PatientSubscription?

  patientAssignments   PatientTherapistAssignment[] @relation("PatientAssignments")
  therapistAssignments PatientTherapistAssignment[] @relation("TherapistAssignments")

  patientAppointments   Appointment[] @relation("PatientAppointments")
  therapistAppointments Appointment[] @relation("TherapistAppointments")

  verificationTokens VerificationToken[]
  otpCodes           OtpCode[]
  sentMessages       Message[]

  @@index([status, role])
  @@map("users")
}

/// Liens à usage unique envoyés par email : vérification d'adresse et réinitialisation de mot de passe.
model VerificationToken {
  id        Int                   @id @default(autoincrement())
  userId    Int                   @map("user_id")
  tokenHash String                @unique @map("token_hash") @db.VarChar(255)
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  email_verify
  password_reset
}

/// Code à 6 chiffres pour la vérification du numéro de téléphone, par SMS ou WhatsApp.
model OtpCode {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  codeHash    String     @map("code_hash") @db.VarChar(255)
  channel     OtpChannel
  phoneNumber String     @map("phone_number") @db.VarChar(20)
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("otp_codes")
}

enum OtpChannel {
  sms
  whatsapp
}

enum UserStatus {
  active
  suspended
  archived
}

enum UserRole {
  patient
  therapist
  admin
}

model PatientProfile {
  id                Int     @id @default(autoincrement())
  userId            Int     @unique @map("user_id")
  nickname          String  @db.VarChar(50)
  avatarUrl         String? @map("avatar_url") @db.VarChar(255)
  onboardingAnswers Json?   @map("onboarding_answers")
  timezone          String  @default("UTC") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id])

  @@map("patient_profiles")
}

model TherapistProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  specialties       String?   @db.Text
  bio               String?   @db.Text
  profilePictureUrl String?   @map("profile_picture_url") @db.VarChar(255)
  isVerified        Boolean   @default(false) @map("is_verified")
  hourlyRate        Decimal   @default(0.00) @map("hourly_rate") @db.Decimal(10, 2)
  languages         String?   @db.VarChar(255)
  diplomaUrl        String?   @map("diploma_url") @db.VarChar(512)
  documentsJson     Json?     @map("documents_json")
  rejectedAt        DateTime? @map("rejected_at")

  user User @relation(fields: [userId], references: [id])

  @@map("therapist_profiles")
}

// =========================================================================
// MODULE 2 : ABONNEMENTS & PAIEMENT MOBILE MONEY
// =========================================================================

model SubscriptionPlan {
  id                   Int     @id @default(autoincrement())
  name                 String  @db.VarChar(50)
  price                Decimal @db.Decimal(10, 2)
  currency             String  @default("XOF") @db.VarChar(3)
  videoMinutesIncluded Int     @default(180) @map("video_minutes_included")
  isActive             Boolean @default(true) @map("is_active")

  subscriptions PatientSubscription[]

  @@map("subscription_plans")
}

model PatientSubscription {
  id                    Int                @id @default(autoincrement())
  patientId             Int                @unique @map("patient_id")
  planId                Int                @map("plan_id")
  status                SubscriptionStatus @default(unpaid)
  lastOmTransactionRef  String?            @map("last_om_transaction_ref") @db.VarChar(255)
  currentPeriodStart    DateTime           @map("current_period_start")
  currentPeriodEnd      DateTime           @map("current_period_end")
  videoMinutesRemaining Int                @map("video_minutes_remaining")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  patient User             @relation(fields: [patientId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("patient_subscriptions")
}

enum SubscriptionStatus {
  active
  past_due
  unpaid
}

// =========================================================================
// MODULE 3 : RELATIONS, MATCHING & RENDEZ-VOUS
// =========================================================================

model PatientTherapistAssignment {
  id          Int              @id @default(autoincrement())
  patientId   Int              @map("patient_id")
  therapistId Int              @map("therapist_id")
  status      AssignmentStatus @default(active)
  assignedAt  DateTime         @default(now()) @map("assigned_at")

  patient   User @relation("PatientAssignments", fields: [patientId], references: [id])
  therapist User @relation("TherapistAssignments", fields: [therapistId], references: [id])

  @@unique([patientId, therapistId])
  @@map("patient_therapist_assignments")
}

enum AssignmentStatus {
  active
  paused
  terminated
}

model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  therapistId     Int               @map("therapist_id")
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(45) @map("duration_minutes")
  status          AppointmentStatus @default(pending)
  type            AppointmentType   @default(video)
  webrtcRoomId    String?           @map("webrtc_room_id") @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at")

  patient   User @relation("PatientAppointments", fields: [patientId], references: [id])
  therapist User @relation("TherapistAppointments", fields: [therapistId], references: [id])
  messages  Message[]

  @@index([scheduledAt])
  @@map("appointments")
}

enum AppointmentStatus {
  pending
  confirmed
  canceled
  completed
}

enum AppointmentType {
  text
  audio
  video
}

/// Message échangé pendant une séance de type "messagerie" (chat).
model Message {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @map("appointment_id")
  senderId      Int       @map("sender_id")
  body          String    @db.Text
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([appointmentId, createdAt])
  @@map("messages")
}

// =========================================================================
// MODULE 4 : WEBRTC SIGNALING
// =========================================================================

model WebrtcSignal {
  id        Int      @id @default(autoincrement())
  roomId    String   @map("room_id") @db.VarChar(100)
  fromRole  String   @map("from_role") @db.VarChar(20)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("webrtc_signals")
}
